# AI Engine Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-2.5-flash"
AI_RATE_LIMIT_ANON="30"
AI_RATE_LIMIT_AUTH="60"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AUTH_SECRET: Key for signing authentication sessions and tokens
AUTH_SECRET="christian_radios_super_secret_jwt_key_32_chars_min"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/christian_radios?schema=public"

# PESAPAL Payment Gateway Integration
PESAPAL_CONSUMER_KEY="pesapal_live_or_sandbox_consumer_key"
PESAPAL_CONSUMER_SECRET="pesapal_live_or_sandbox_consumer_secret"
PESAPAL_IPN_ID="pesapal_ipn_id_registered_guid"
PESAPAL_ENV="sandbox" # sandbox or live

# Email / SMTP Settings
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@christianradios.org"
SMTP_PASS="smtp_password"
EMAIL_FROM="Christian Radios <no-reply@christianradios.org>"

