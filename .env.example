# Christian Radios Platform - Environment Variables Template
# Use this template for a local .env, or configure these in Railway Project Variables.
#
# Anything marked REQUIRED IN PRODUCTION must be set before deploying with
# NODE_ENV=production. The server refuses to start without them rather than
# falling back to a value that is published in this repository.

# ==========================================
# 1. CORE APPLICATION & DEPLOYMENT
# ==========================================
NODE_ENV=production
PORT=3000
# The public domain of your deployed application (used for CORS, redirects & webhooks)
APP_URL=https://your-domain.up.railway.app

# REQUIRED IN PRODUCTION. Signs session tokens. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# REQUIRED IN PRODUCTION. Encrypts payment gateway credentials stored in the
# database. Generate a separate value from AUTH_SECRET:
#   openssl rand -base64 48
INTEGRATION_ENCRYPTION_KEY=

# Number of reverse proxy hops in front of the app. Railway terminates TLS at a
# single proxy, so 1 is correct there. Setting this too high lets clients spoof
# their IP address and bypass rate limiting.
TRUSTED_PROXY_HOPS=1

# ==========================================
# 2. POSTGRESQL DATABASE
# ==========================================
# STRONGLY RECOMMENDED IN PRODUCTION. Container filesystems are ephemeral, so
# without Postgres every account, payment, donation and ledger entry is lost on
# each redeploy. With it set, the database is snapshotted to Postgres and
# restored on boot.
# When using the Railway Postgres plugin, DATABASE_URL is injected automatically.
DATABASE_URL=

# How often (ms) to push the durable snapshot to Postgres. Default 5000.
DB_SNAPSHOT_INTERVAL_MS=5000

# ==========================================
# 3. BOOTSTRAP SUPER ADMIN
# ==========================================
# Credentials for the initial super-admin account created on an empty database.
# If SEED_ADMIN_PASSWORD is unset in production a random one is generated and
# printed to the deploy logs exactly once.
SEED_ADMIN_EMAIL=admin@your-domain.org
SEED_ADMIN_PASSWORD=

# ==========================================
# 4. AI & MINISTRY INTELLIGENCE (Google Gemini)
# ==========================================
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ==========================================
# 5. TRANSACTIONAL EMAIL (Resend)
# ==========================================
# Used for welcome emails, verification codes, and payout/ticket alerts
RESEND_API_KEY=

# ==========================================
# 6. GOOGLE OAUTH SIGN-IN (Optional)
# ==========================================
# Google Cloud Console OAuth 2.0 Client ID. Sign-in with Google verifies the ID
# token against this client id, so it must match the one the frontend uses.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ==========================================
# 7. PESAPAL 3.0 (East Africa M-Pesa, Airtel, Tigo & Cards)
# ==========================================
# Register your merchant account at https://pesapal.com/
# In production, payments cannot be confirmed unless these are configured.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Set to 'sandbox' for testing, or 'live' for real payments
PESAPAL_ENV=sandbox

# ==========================================
# 8. PAYPAL V2 REST API (Global PayPal & Cards)
# ==========================================
# Developer Dashboard at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' or 'live'
PAYPAL_ENV=sandbox

# ==========================================
# 9. STRIPE API (International Credit / Debit Cards)
# ==========================================
# Stripe Dashboard at https://dashboard.stripe.com/
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# REQUIRED to accept Stripe payments. Webhook events without a valid signature
# are rejected, so payments will never settle without this.
# Point the webhook at: https://your-domain/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
