# Christian Radios Platform - Environment Variables Template
# Use this template for local .env or configure in Railway Project Variables

# ==========================================
# 1. CORE APPLICATION & DEPLOYMENT
# ==========================================
NODE_ENV=production
PORT=3000
# The public domain of your deployed application (used for CORS, redirects & webhooks)
APP_URL=https://your-domain.up.railway.app
# Secret salt key for JWT signing & secure cookie encryption (minimum 32 characters)
AUTH_SECRET=christian_radios_prod_secret_2026_salt_hash_min32_change_me

# ==========================================
# 2. POSTGRESQL DATABASE
# ==========================================
# When using Railway Postgres plugin, DATABASE_URL is automatically injected
DATABASE_URL=postgresql://postgres:password@localhost:5432/christian_radios

# ==========================================
# 3. AI & MINISTRY INTELLIGENCE (Google Gemini)
# ==========================================
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ==========================================
# 4. TRANSACTIONAL EMAIL (Resend)
# ==========================================
# Used for welcome emails, verification codes, and payout/ticket alerts
RESEND_API_KEY=

# ==========================================
# 5. GOOGLE OAUTH SIGN-IN (Optional)
# ==========================================
# Google Cloud Console OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ==========================================
# 6. PESAPAL 3.0 (East Africa M-Pesa, Airtel, Tigo & Cards)
# ==========================================
# Register your merchant account at https://pesapal.com/
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Set to 'sandbox' for test testing, or 'live' for real payments
PESAPAL_ENV=sandbox

# ==========================================
# 7. PAYPAL V2 REST API (Global PayPal & Cards)
# ==========================================
# Developer Dashboard at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ==========================================
# 8. STRIPE API (International Credit / Debit Cards)
# ==========================================
# Stripe Dashboard at https://dashboard.stripe.com/
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
